# Nebius Token Factory & NVIDIA Nemotron (Official Nebius x NVIDIA Hackathon Infrastructure)
NEBIUS_API_KEY=your_nebius_api_key_here
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
NEBIUS_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1/

# Groq Cloud API (Fast conversational fallback)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# AssemblyAI API (Optional alternative for speech-to-text)
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# ElevenLabs API (Optional neural TTS)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
